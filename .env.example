# ProjectFlow Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OpenRouter API Key for AI Code Assistant (Optional but recommended)
VITE_OPENROUTER_API_KEY=your-openrouter-api-key

# Super Admin Email (for admin features)
VITE_SUPER_ADMIN_EMAIL=your_admin_email@example.com

# GitHub Token for Code Studio (Optional)
VITE_GITHUB_TOKEN=your_github_personal_access_token