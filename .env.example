# ProjectFlow Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional desktop OAuth callback (add this exact URL to Supabase Auth Redirect URLs)
VITE_DESKTOP_AUTH_REDIRECT_URL=projectflow://auth/callback

# Optional JSON array of RTCIceServer values for WebRTC; STUN/TURN providers are not bundled.
# VITE_MEETING_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"}]

# Super Admin Email (for admin features)
VITE_SUPER_ADMIN_EMAIL=your_admin_email@example.com