{
  "id": "com.projectflow.workspace",
  "name": "ProjectFlow Workspace",
  "short_name": "ProjectFlow",
  "description": "Collaborative agile engineering workspace, task Kanban, and sprint management platform.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "categories": [
    "productivity",
    "business",
    "developer tools"
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "iarc_rating_id": "",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Quick Capture",
      "short_name": "Capture",
      "description": "Dictate voice notes or photograph whiteboard diagrams",
      "url": "/capture",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Triage Deck",
      "short_name": "Triage",
      "description": "One-handed swipe triage for backlog deliverables",
      "url": "/triage",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Daily Standup",
      "short_name": "Standup",
      "description": "View sprint stories and share async updates",
      "url": "/standup",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Team Chat",
      "short_name": "Chat",
      "description": "Open workspace messaging channels",
      "url": "/messages",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Sprint Overview",
      "short_name": "Sprint",
      "description": "Quick view of active sprint progress",
      "tag": "projectflow-sprint-widget",
      "template": "widget",
      "ms_ac_template": "widget-card.json",
      "data": "/tasks",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-mobile.png",
          "sizes": "720x1280",
          "label": "Sprint widget preview"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/capture",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "description",
      "url": "link"
    }
  },
  "file_handlers": [
    {
      "action": "/code",
      "name": "Source Code File",
      "accept": {
        "text/plain": [".txt", ".md"],
        "application/json": [".json"],
        "text/javascript": [".js", ".jsx", ".ts", ".tsx"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+projectflow",
      "url": "/tasks?ref=%s"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "353x708",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Sprint Kanban and team boards on mobile"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1917x917",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Full workspace overview and Code Studio on desktop"
    }
  ]
}