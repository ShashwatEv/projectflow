# .gitignore

*supabase/

# Dependencies & build outputs
node_modules/
dist/
build/
release/
*.tsbuildinfo

# Environment variables & secrets (keep .env.example tracked)
.env
.env.*
!.env.example

# Supabase local state, schema dumps & ad-hoc SQL queries
.supabase/
*.csv
*.sql
!supabase/migrations/*.sql

# Local snapshots & helper scripts
snap.py
project_snapshot*.txt

# AI & editor config
.continue/
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Mobile & desktop packaging artifacts / signing keys
downloads/
*.apk
*.aab
*.exe
*.dmg
*.keystore
*.jks
*.p12
*.pem
signing-key-info.txt
